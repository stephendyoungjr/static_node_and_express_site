extends layout.pug

block content

  nav.nav
    a(href='/')
      span &larr;
      |  Back

  article.portfolio-projects
    .inner-wrapper.flex-row-wrap.two-col
      .project-info-box.box
        h1= project.project_name
        p= project.description

      .project-tech-links-box.box
        h6 Technologies
        ul
          //- One list item per technology
          each tech in project.technologies
            li= tech

        a.btn-link(href=project.live_link, target='_blank', rel='noopener') Live Demo
        a.btn-link(href=project.github_link, target='_blank', rel='noopener') GitHub Repo

    .project-img-box.box
      //- One image per entry in image_urls
      each image, index in project.image_urls
        img.project-img(src=image, alt=`${project.project_name} screenshot ${index + 1}`)

    nav.nav
      a(href='/')
        span &larr;
        |  Back
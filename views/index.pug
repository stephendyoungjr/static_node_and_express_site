extends layout.pug

block content

  article.portfolio-intro
    h1 Hey, Potential Employers
    p Welcome to my portfolio. Here are two full-stack projects I built with React, Express, and PostgreSQL, from a fantasy-world booking marketplace to an event management platform.

  article.portfolio-project-thumbs
    .projects-box.box.grid
      //- Loop over the projects and build a thumbnail linking to each project page
      each project in projects
        .cell
          a(href=`/project/${project.id}`)
            img.thumbnail(src=project.image_urls[0], alt=`Thumbnail ${project.project_name}`)
            h5= project.project_name